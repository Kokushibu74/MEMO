async function themeMenu() {
  clear();

  console.log("╔════════════════════════════╗");
  console.log("║       MEMO THEMES 🎨       ║");
  console.log("╚════════════════════════════╝\n");

  const list = themes();

  list.forEach((theme, i) => {
    console.log(`${i + 1}. ${theme}`);
  });

  console.log("0. Back\n");

  const choice = (
    await ask("Select theme: ")
  ).trim();

  const number = Number(choice);

  if (
    !Number.isInteger(number) ||
    number < 1 ||
    number > list.length
  ) {
    return;
  }

  const selected = list[number - 1];

  let config = loadJSON(THEME_CONFIG, {});

  config.selected = selected;

  if (selected === "Custom") {
    const custom = (
      await ask("Custom theme name: ")
    ).trim();

    if (custom) config.custom = custom;
  }

  saveJSON(THEME_CONFIG, config);

  console.log(`\n✅ Theme: ${selected}`);
  await pause();
}

function showHistory() {
  clear();

  console.log("╔════════════════════════════╗");
  console.log("║      RECENT CHAT HISTORY   ║");
  console.log("╚════════════════════════════╝\n");

  let memory = {};

  for (const file of MEMORY_FILES) {
    const data = loadJSON(
      path.join(APP_DIR, file),
      {}
    );

    if (Object.keys(data).length) {
      memory = data;
      break;
    }
  }

  const chats = Object.entries(memory);

  if (!chats.length) {
    console.log("No conversation history found.");
    return;
  }

  chats.forEach(([jid, messages], i) => {
    console.log(`\n[${i + 1}] ${jid}`);

    if (!Array.isArray(messages)) return;

    messages
      .slice(-5)
      .forEach(item => {
        const role =
          item.role === "user"
            ? "USER"
            : "MEMO";

        console.log(
          `  ${role}: ${String(item.text || "").slice(0, 120)}`
        );
      });
  });
}

async function resetMemo() {
  clear();

  console.log("╔════════════════════════════╗");
  console.log("║       RESET MEMO 1.5       ║");
  console.log("╚════════════════════════════╝\n");

  console.log(
    "This removes:"
  );

