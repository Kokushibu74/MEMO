  console.log("• Conversation memory");
  console.log("• Theme/settings cache");

  console.log(
    "\nSource code will NOT be deleted.\n"
  );

  const confirm = (
    await ask("Type RESET to continue: ")
  ).trim();

  if (confirm !== "RESET") {
    console.log("\n❌ Reset cancelled.");
    await pause();
    return;
  }

  for (const file of MEMORY_FILES) {
    const target = path.join(APP_DIR, file);

    if (fs.existsSync(target)) {
      fs.writeFileSync(target, "{}");
    }
  }

  if (fs.existsSync(AI_CONFIG)) {
    saveJSON(AI_CONFIG, {
      version: "1.5",
      timeout_ms: 12000,
      auto_failover: true,
      providers: {
        gemini: {
          name: "Google Gemini",
          enabled: false,
          priority: 1,
          model: "gemini-2.5-flash",
          apiKey: ""
        },
        chatgpt: {
          name: "ChatGPT / OpenAI",
          enabled: false,
          priority: 2,
          model: "gpt-4o-mini",
          apiKey: ""
        },
        claude: {
          name: "Anthropic Claude",
          enabled: false,
          priority: 3,
          model: "claude-3-5-haiku-latest",
          apiKey: ""
        },
        grok: {
          name: "xAI Grok",
          enabled: false,
          priority: 4,
          model: "grok-3-mini",
          apiKey: ""
        },
        deepseek: {
          name: "DeepSeek",
          enabled: false,
          priority: 5,
          model: "deepseek-chat",
          apiKey: ""
        },
        groq: {
          name: "Groq",
          enabled: false,
          priority: 6,
          model: "llama-3.3-70b-versatile",
          apiKey: ""
        }
      }
    });
  }

  if (fs.existsSync(THEME_CONFIG)) {
    saveJSON(THEME_CONFIG, {
      selected: "Default Dark"
    });
  }

  const authDir = path.join(APP_DIR, "auth_info");

  if (fs.existsSync(authDir)) {
    fs.rmSync(authDir, {
      recursive: true,
      force: true
    });
  }

  fs.mkdirSync(authDir, {
    recursive: true
  });

  console.log("\n✅ MEMO 1.5 reset complete.");
  console.log("Source code preserved.");
  await pause();
}

