import fs from "fs";
import path from "path";
import readline from "readline";
import { listProviders, setProvider, removeProviderKey } from "./providers/index.js";

const APP_DIR = process.cwd();
const AI_CONFIG = path.join(APP_DIR, "config", "ai.json");
const THEME_CONFIG = path.join(APP_DIR, "config", "themes.json");
const MEMORY_FILES = [
  "memo_memory.json",
  "memo_contexts.json",
  "memory.json"
];

const rl = readline.createInterface({
  input: process.stdin,
  output: process.stdout
});

const ask = q =>
  new Promise(resolve => rl.question(q, resolve));

function clear() {
  process.stdout.write("\x1b[2J\x1b[H");
}

function pause() {
  return ask("\nPress Enter to continue...");
}

function loadJSON(file, fallback = {}) {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch {
    return fallback;
  }
}

function saveJSON(file, data) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, JSON.stringify(data, null, 2));
}

function maskKey(key) {
  if (!key) return "Not configured";
  if (key.length <= 8) return "••••••••";
  return key.slice(0, 4) + "••••••••" + key.slice(-4);
}

function providerStatus() {
  const config = loadJSON(AI_CONFIG, { providers: {} });
  const providers = Object.entries(config.providers || {});

  console.log("\n🧠 AI PROVIDERS\n");

  if (!providers.length) {
    console.log("  No providers found.");
    return;
  }

  providers
    .sort(([, a], [, b]) =>
      Number(a.priority ?? 999) - Number(b.priority ?? 999)
    )
    .forEach(([id, p], i) => {
      const status =
        p.enabled === true && p.apiKey
          ? "● ACTIVE"
          : "○ OFF";

      console.log(
        `  ${i + 1}. ${p.name || id} — ${status}`
      );
      console.log(
        `     Priority: ${p.priority ?? "-"}`
      );
      console.log(
        `     Model: ${p.model || "-"}`
      );
      console.log(
        `     Key: ${maskKey(p.apiKey)}`
      );
    });
}

async function addProvider() {
  clear();

  console.log("╔════════════════════════════╗");
  console.log("║       ADD AI BRAIN 🧠      ║");
  console.log("╚════════════════════════════╝\n");

  console.log("1. ChatGPT");
  console.log("2. Gemini");
  console.log("3. Claude");
  console.log("4. Grok");
  console.log("5. DeepSeek");
  console.log("6. Groq");
  console.log("0. Back\n");

  const choice = (await ask("Select: ")).trim();

  const map = {
    "1": "chatgpt",
    "2": "gemini",
    "3": "claude",
    "4": "grok",
    "5": "deepseek",
    "6": "groq"
  };

  const id = map[choice];

  if (!id) return;

  const key = (await ask("\nAPI Key: ")).trim();

  if (!key) {
    console.log("❌ API key cannot be empty.");
    await pause();
    return;
  }

  const current = loadJSON(AI_CONFIG, {
    providers: {}
  });

  const existing = current.providers?.[id] || {};

  setProvider(id, {
    ...existing,
    apiKey: key,
    enabled: true,
    priority: existing.priority || 99
  });

  console.log(`\n✅ ${id} API configured.`);
  await pause();
}

async function removeProvider() {
  clear();

  providerStatus();

  const id = (
    await ask("\nProvider ID to remove (or 0): ")
  ).trim();

  if (id === "0") return;

  const valid = [
    "gemini",
    "chatgpt",
    "claude",
    "grok",
    "deepseek"
  ];

  if (!valid.includes(id)) {
    console.log("❌ Invalid provider.");
    await pause();
    return;
  }

  const confirm = (
    await ask(`Remove ${id}? (yes/no): `)
  ).trim().toLowerCase();

  if (confirm !== "yes") {
    console.log("Cancelled.");
    await pause();
    return;
  }

  removeProviderKey(id);

  console.log(`\n✅ ${id} removed.`);
  await pause();
}

async function reorderProviders() {
  clear();

  const config = loadJSON(AI_CONFIG, {
    providers: {}
  });

  const providers = Object.entries(
    config.providers || {}
  ).filter(([, p]) => p?.apiKey);

  if (!providers.length) {
    console.log("No configured providers.");
    await pause();
    return;
  }

  console.log("╔════════════════════════════╗");
  console.log("║      AI PRIORITY ORDER     ║");
  console.log("╚════════════════════════════╝\n");

  providers
    .sort(
      ([, a], [, b]) =>
        Number(a.priority ?? 99) -
        Number(b.priority ?? 99)
    )
    .forEach(([id, p], i) => {
      console.log(`${i + 1}. ${id} — ${p.model || ""}`);
    });

  console.log(
    "\nEnter provider IDs in desired order."
  );
  console.log(
    "Example: gemini,chatgpt,claude,grok,deepseek\n"
  );

  const input = (
    await ask("New order: ")
  ).trim();

  if (!input) return;

  const order = input
    .split(",")
    .map(x => x.trim())
    .filter(Boolean);

  order.forEach((id, index) => {
    if (config.providers?.[id]) {
      config.providers[id].priority = index + 1;
    }
  });

  saveJSON(AI_CONFIG, config);

  console.log("\n✅ AI priority updated.");
  await pause();
}

async function apiMenu() {
  while (true) {
    clear();

    console.log("╔════════════════════════════╗");
    console.log("║     AI BRAIN MANAGER 🧠    ║");
    console.log("╚════════════════════════════╝\n");

    console.log("1. Add API");
    console.log("2. Remove API");
    console.log("3. List APIs");
    console.log("4. Change AI Priority");
    console.log("0. Back\n");

    const choice = (
      await ask("Select: ")
    ).trim();

    if (choice === "1") await addProvider();
    else if (choice === "2") await removeProvider();
    else if (choice === "3") {
      clear();
      providerStatus();
      await pause();
    }
    else if (choice === "4") await reorderProviders();
    else if (choice === "0") return;
  }
}

