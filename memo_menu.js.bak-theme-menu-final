async function mainMenu() {
  while (true) {
    clear();

    console.log(`
╔════════════════════════════╗
║        M E M O 1.5        ║
║   WhatsApp AI Assistant   ║
╚════════════════════════════╝

1. Start MEMO 1.5
2. Add or Remove Brain 🧠 API
3. Recent Chat History
4. Change Theme
5. Reset MEMO 1.5
6. About MEMO 1.5

0. Exit
`);

    const choice = (
      await ask("Select: ")
    ).trim();

    if (choice === "1") {
      rl.close();

      const { spawn } = await import("child_process");

      spawn(
        process.execPath,
        ["memo.js"],
        {
          stdio: "inherit",
          cwd: APP_DIR
        }
      );

      return;
    }

    if (choice === "2") {
      await apiMenu();
      continue;
    }

    if (choice === "3") {
      showHistory();
      await pause();
      continue;
    }

    if (choice === "4") {
      await themeMenu();
      continue;
    }

    if (choice === "5") {
      await resetMemo();
      continue;
    }

    if (choice === "6") {
      about();
      await pause();
      continue;
    }

    if (choice === "0") {
      rl.close();
      return;
    }
  }
}

mainMenu().catch(error => {
